# Caddy reverse proxy for the Reyu stack.
#
# Routes:
#   /api/*  -> backend:8000  (FastAPI)
#   /ws/*   -> backend:8000  (WebSocket — Caddy auto-upgrades)
#   /       -> frontend:5173 (Vite dev server)
#
# Everything is same-origin from the browser's POV, so CORS is moot.
#
# CURRENT MODE: IP-based (:80). No HTTPS. For testing.
#
# To switch to HTTPS with a domain later:
#   1. Comment out the `:80` block
#   2. Uncomment the `app.reyu.ai` block
#   3. DNS A record: app.reyu.ai -> <VM_PUBLIC_IP>
#   4. GCP firewall open on tcp:80 (ACME HTTP-01 challenge) + tcp:443
#   5. Update .env FYERS_REDIRECT_URI / CORS_ORIGINS / FRONTEND_URL
#      to https://app.reyu.ai/...
#   6. Update Fyers dashboard redirect_uri to match

:80 {
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /ws/* {
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:5173
    }
    encode gzip
}

