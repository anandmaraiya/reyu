# Fyers API credentials — https://myapi.fyers.in/dashboard
FYERS_APP_ID=YOUR_APP_ID-100
FYERS_SECRET_KEY=YOUR_SECRET_KEY
FYERS_REDIRECT_URI=http://localhost:8000/api/auth/callback

# Backend
JWT_SECRET=change-me-in-production
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql+asyncpg://reyu:reyu@postgres:5432/reyu
DATA_DIR=/app/data

# Symbols polled every 60s for tick + chain snapshots (comma-separated)
TRACKED_SYMBOLS=NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX
SNAPSHOT_INTERVAL_SEC=60

# Risk defaults
RISK_PER_TRADE_PCT=1.0
PORTFOLIO_MAX_DELTA=500
PORTFOLIO_MAX_VEGA=2000

# Telegram bot — create one via @BotFather, then set the webhook:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<public-url>/api/telegram/webhook"
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=reyu_ai_bot

# OpenRouter LLM (powers the AI Co-pilot). Leave blank to use the regex
# fallback router. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
