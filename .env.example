# ── Reyu.ai — Environment Variables ─────────────────────────────────────────
# Copy this to .env and fill in the blanks before starting Docker.
# Never commit .env to version control.

# ── Fyers broker ─────────────────────────────────────────────────────────────
FYERS_APP_ID=
FYERS_SECRET_KEY=
# The redirect URI MUST match exactly what you registered in the Fyers dev portal.
# For Linux VM / production: replace localhost with your server IP or domain.
FYERS_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ── Server URLs ──────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://reyu:reyu@postgres:5432/reyu

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Data storage ─────────────────────────────────────────────────────────────
DATA_DIR=/app/data

# ── Risk defaults ────────────────────────────────────────────────────────────
RISK_PER_TRADE_PCT=1.0
PORTFOLIO_MAX_DELTA=500
PORTFOLIO_MAX_VEGA=2000

# ── Tracked index symbols (comma-separated Fyers format) ─────────────────────
TRACKED_SYMBOLS=NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,NSE:FINNIFTY-INDEX,NSE:INDIA VIX-INDEX

# ── Snapshot interval ────────────────────────────────────────────────────────
SNAPSHOT_INTERVAL_SEC=60

# ── Razorpay billing (leave blank to disable) ────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_ALGO_MONTHLY=
RAZORPAY_PLAN_ALGO_YEARLY=
RAZORPAY_CALLBACK_URL=http://localhost:5173/subscription

# ── LLM providers (preference order: Anthropic > OpenRouter > regex) ─────────
# Direct Claude API — cheaper + faster. Get key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# OpenRouter — fallback / multi-provider gateway (used if ANTHROPIC key blank)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-haiku
OPENROUTER_REFERER=https://reyu.ai
OPENROUTER_APP_NAME=Reyu.ai Options Co-pilot

# ── Telegram bot (optional) ───────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=

# ── CORS origins (comma-separated) ────────────────────────────────────────────
# Include every origin that will host the frontend. Same-origin behind Caddy
# means one entry suffices in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend base URL ─────────────────────────────────────────────────────────
# Used to build reset-password links in emails. Must match the domain where
# the SPA is served (Caddy target in prod).
FRONTEND_URL=http://localhost:5173

# ── Resend transactional email ────────────────────────────────────────────────
# https://resend.com/api-keys — create a key + verify the sender domain first
RESEND_API_KEY=
RESEND_FROM_EMAIL=Reyu <no-reply@reyu.ai>

# ── PostHog analytics ─────────────────────────────────────────────────────────
# Server-side key (write-only). Frontend key is separate — see below.
# https://us.i.posthog.com/project/settings/project-details
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Frontend PostHog key — same public write-only project key. Loaded into
# Vite at build time via docker-compose environment.
POSTHOG_API_KEY_PUBLIC=
