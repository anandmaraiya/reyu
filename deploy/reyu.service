[Unit]
Description=Reyu.ai Trading Platform
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/reyu
ExecStart=/usr/bin/docker compose -f /opt/reyu/docker-compose.cloud.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/reyu/docker-compose.cloud.yml down
ExecReload=/usr/bin/docker compose -f /opt/reyu/docker-compose.cloud.yml up -d --remove-orphans
TimeoutStartSec=180
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
